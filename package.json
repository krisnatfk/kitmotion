{
  "name": "kitmotion",
  "version": "0.1.0",
  "private": true,
  "description": "KITMOTION — application-first MVP. Camera-based pose exercise app (PWA). IoT-ready, not IoT-active.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:fresh": "node scripts/clean-next-cache.mjs --dev && node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "clean": "node scripts/clean-next-cache.mjs --all",
    "clean:dev": "node scripts/clean-next-cache.mjs --dev",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ai:test": "node scripts/test-ai.mjs",
    "db:link": "npx supabase link",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "db:types": "npx supabase gen types typescript --local --schema public > src/types/database.types.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@mediapipe/tasks-vision": "^0.10.18",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "next": "^15.1.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "next": {
      "sharp": "0.35.3"
    }
  },
  "engines": {
    "node": ">=18.18"
  }
}
