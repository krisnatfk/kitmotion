# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# --- Supabase (fill with your project creds) ---
# Local CLI: run `supabase start` then use the values printed by `supabase status`.
# Cloud: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# SERVER ONLY — never expose to the client. Used by Server Actions / Route Handlers
# to finalize sessions, apply XP, and verify admin role.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Generative AI coach (SERVER ONLY, optional) ---
# Generic names keep the app independent from a specific model vendor.
# The first adapter uses the OpenAI-compatible protocol, which is also offered
# by many hosted providers and local servers such as Ollama or LM Studio.
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=20000

# --- MediaPipe Pose Landmarker (loaded only on /workout routes, from CDN) ---
NEXT_PUBLIC_MEDIAPIPE_MODEL_PATH=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task
NEXT_PUBLIC_MEDIAPIPE_WASM_PATH=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/wasm

# --- IoT readiness (future). MUST stay false for the application-first MVP. ---
# When true (future phase), an IoTSensorProvider may be swapped in. No IoT endpoints
# or tables exist yet, so leaving this false is the only safe value.
NEXT_PUBLIC_IOT_INTEGRATION_ENABLED=false
